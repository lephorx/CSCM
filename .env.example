# ── Local database (SQLite) ────────────────────────────────────────────────
# Single file holding both app data and auth data.
DB_PATH=cscm.db
AUTH_DB_PATH=cscm.db

# ── Docker / Minecraft server management ──────────────────────────────────
MC_IMAGE=itzg/minecraft-server:java21

# All four paths below MUST be absolute — Docker rejects relative paths for
# bind mounts.
#
# Path as seen INSIDE the management container (used for file/backup/property I/O).
SERVERS_DIR=/data/servers
BACKUPS_DIR=/data/backups

# Path as seen by the DOCKER DAEMON on the HOST — used only when creating bind
# mounts for Minecraft server containers. Must point at the same physical
# directory as SERVERS_DIR/BACKUPS_DIR above, just expressed as a host path.
# If running the management app directly on the host (no docker socket
# indirection), set these equal to SERVERS_DIR/BACKUPS_DIR.
SERVERS_DIR_HOST=/opt/cscm/servers
BACKUPS_DIR_HOST=/opt/cscm/backups

# ── PlayIT.gg ──────────────────────────────────────────────────────────────
PLAYIT_EMAIL=<playit-email>
PLAYIT_PASSWORD=<playit-password>
PLAYIT_HEADLESS=false
PLAYIT_SUBSCRIPTION=premium            # premium | free

# You can only select a region for the premium network otherwise it will be chosen by playit
PLAYIT_REGION=Germany             # Seattle, Los Angeles, Denver, Dallas, Chicago, New York, Miami, Germany, United Kingdom, Sweden, Poland, Spain, Singapore, Japan, Australia, Sao Paulo, Chile, India
PLAYIT_AGENT=<playit-agent-name>  # Agent name (leave empty to use first available)

# ── Cloudflare ─────────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=<cloudflare-api-token>
CLOUDFLARE_ZONE_ID=<cloudflare-zone-id>
CLOUDFLARE_BASE_DOMAIN=<cloudflare-base-domain>

# ── Flask API ──────────────────────────────────────────────────────────────
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
JWT_LIFETIME_HOURS=8
TOTP_ISSUER=CSCM Tool

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR

# ── ZFS backups (optional) ────────────────────────────────────────────────
# Base ZFS dataset under which each server has its own child dataset.
# Example: tank/cscm/servers → server 3 uses dataset tank/cscm/servers/3
# Leave empty to disable ZFS backup type.
# Requires: /sbin/zfs mounted into the container + /dev/zfs device access.
ZFS_DATASET_BASE=
