# Cloudflare (used for NS record delegation to playit)
CLOUDFLARE_API_TOKEN=your_api_token_here
CLOUDFLARE_ZONE_ID=your_zone_id_here
CLOUDFLARE_DOMAIN=homeops.services

# playit.gg (get secret key from: https://playit.gg/account/setup/wizard)
PLAYIT_SECRET_KEY=your_playit_secret_key_here

# Crafty Controller (Minecraft server manager)
BASE_URL=https://localhost:8443
USERNAME=admin
PASSWORD=admin

# PostgreSQL database
DB_NAME=cscm
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_HOST=localhost
DB_PORT=5432
